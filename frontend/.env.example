# WeatherSphere Frontend — Environment Variables Template
# Copy this file to .env and fill in your values.

# ── Mapbox (required for 3D globe rendering) ──────────────────────
# Get your free token at: https://account.mapbox.com/
# This is safe to expose — restrict by domain in your Mapbox dashboard.
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# ── Backend API URL ───────────────────────────────────────────────
# Development: http://localhost:3001 (direct to backend)
# Production: http://localhost (Nginx load balancer on port 80)
VITE_API_BASE=http://localhost:3001
